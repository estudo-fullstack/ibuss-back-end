generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(100)
  cpf       String    @db.VarChar(11) @unique
  email     String    @unique
  phoneNumber String @db.VarChar(20)
  password  String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets   Ticket[]
  transactions WalletTransaction[]
}

model BusCompany {
  id        String @id @default(uuid())
  name      String @db.VarChar(150)
  cnpj      String @db.VarChar(14) @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes    Route[]
}

model Route {
  id            String @id @default(uuid())

  companyId     String
  company       BusCompany @relation(fields: [companyId], references: [id])

  routeNumber  String @db.VarChar(10) @unique
  origin        String @db.VarChar(50)
  destination   String @db.VarChar(50)

  tripDuration Int
  price         Decimal @db.Decimal(10,2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules Schedule[]
  tickets   Ticket[]
}

model Schedule {
  id String @id @default(uuid())

  routeId String
  route   Route @relation(fields: [routeId], references: [id])

  dayOfWeek Int
  departureTime DateTime
  isActive Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id])

  routeId String
  route   Route @relation(fields: [routeId], references: [id])

  walletTransactionId String @unique
  walletTransaction   WalletTransaction @relation(fields: [walletTransactionId], references: [id])

  purchasePrice Decimal @db.Decimal(10,2)
  status String

  purchaseAt DateTime
  usedAt DateTime?
}

model WalletTransaction {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id])

  transactionAmount Decimal @db.Decimal(10,2)
  transactionType String

  createdAt DateTime @default(now())

  ticket Ticket?
}